{
  "name": "morris-shop",
  "version": "1.0.0",
  "private": true,
  "description": "Website TMDT ban sap vuot toc nam - MERN stack",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "seed": "npm run seed --workspace server",
    "seed:destroy": "npm run seed:destroy --workspace server",
    "build": "npm run build --workspace client",
    "test": "npm run test --workspace server",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,jsx,json,md,css}\"",
    "db:up": "docker compose up -d mongo",
    "db:down": "docker compose down",
    "docs:export": "npm run docs:export --workspace server",
    "e2e": "node scripts/e2e-smoke.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "playwright": "^1.63.0",
    "prettier": "^3.4.2"
  }
}
